<%- include('../partials/head', { title: 'Create account' }) %>
</head>
<body class="min-h-screen bg-rose-50 font-sans text-slate-800">
  <%- include('../partials/header') %>

  <main class="relative overflow-hidden px-4 py-10 sm:px-6 lg:py-16">
    <div class="absolute -left-24 top-12 h-72 w-72 rounded-full bg-rose-200/60 blur-3xl"></div>
    <div class="absolute -right-24 bottom-0 h-80 w-80 rounded-full bg-orange-200/60 blur-3xl"></div>

    <div class="relative mx-auto grid max-w-5xl overflow-hidden rounded-[2rem] bg-white shadow-2xl shadow-rose-950/10 ring-1 ring-rose-100 lg:grid-cols-5">
      <aside class="relative hidden overflow-hidden bg-gradient-to-br from-rose-500 via-rose-500 to-orange-400 p-10 text-white lg:col-span-2 lg:flex lg:flex-col">
        <div class="absolute -right-20 -top-16 h-56 w-56 rounded-full border-[28px] border-white/15"></div>
        <div class="absolute -bottom-24 -left-20 h-64 w-64 rounded-full bg-white/10"></div>
        <a href="/" class="relative text-2xl font-bold tracking-tight">stay<span class="text-rose-100">finder</span></a>
        <div class="relative my-auto">
          <p class="mb-3 text-sm font-semibold uppercase tracking-[0.22em] text-rose-100">Welcome home</p>
          <h1 class="text-4xl font-bold leading-tight">Your next stay starts with a simple hello.</h1>
          <p class="mt-5 text-base leading-7 text-rose-50">Discover memorable places, connect with welcoming hosts, and make every trip feel personal.</p>
        </div>
        <div class="relative flex items-center gap-3 text-sm text-rose-100"><span class="flex h-8 w-8 items-center justify-center rounded-full bg-white/20 font-bold">1</span>Create your free account in less than a minute.</div>
      </aside>

      <section class="p-6 sm:p-10 lg:col-span-3">
        <div class="mb-8">
          <span class="inline-flex items-center rounded-full bg-rose-100 px-3 py-1 text-xs font-bold uppercase tracking-wider text-rose-600">Get started</span>
          <h2 class="mt-4 text-3xl font-bold tracking-tight text-slate-900">Create an account</h2>
          <p class="mt-2 text-sm text-slate-500">Fill in your details to join the community.</p>
        </div>
        <div>
          <%if(typeof errorMessages !== 'undefined' && errorMessages &&errorMessages.length>0){%>
            <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative mb-4" role="alert">
              <ul class="list-disc list-inside space-y-1">
                <%errorMessages.forEach(error=>{%>
                <li><%=error%></li>
                <%})%>
              </ul>
            </div>
            <%}%>
        </div>
        <form action="/auth/signup" method="POST" class="space-y-5">
          <div class="grid gap-5 sm:grid-cols-2">
            <div>
              <label for="firstName" class="mb-2 block text-sm font-semibold text-slate-700">First name</label>
              <input id="firstName" type="text" placeholder="Jane" name="Firstname" autocomplete="given-name" required class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm outline-none transition duration-200 placeholder:text-slate-400 hover:border-rose-200 focus:border-rose-500 focus:bg-white focus:ring-4 focus:ring-rose-100">
            </div>
            <div>
              <label for="lastName" class="mb-2 block text-sm font-semibold text-slate-700">Last name <span class="font-normal text-slate-400">(optional)</span></label>
              <input id="lastName" type="text" placeholder="Doe" name="Lastname" autocomplete="family-name" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm outline-none transition duration-200 placeholder:text-slate-400 hover:border-rose-200 focus:border-rose-500 focus:bg-white focus:ring-4 focus:ring-rose-100">
            </div>
          </div>

          <div>
            <label for="email" class="mb-2 block text-sm font-semibold text-slate-700">Email address</label>
            <input id="email" type="email" placeholder="jane@example.com" name="email" autocomplete="email" required class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm outline-none transition duration-200 placeholder:text-slate-400 hover:border-rose-200 focus:border-rose-500 focus:bg-white focus:ring-4 focus:ring-rose-100">
          </div>

          <fieldset>
            <legend class="mb-2 block text-sm font-semibold text-slate-700">How will you use Stayfinder?</legend>
            <div class="grid gap-3 sm:grid-cols-2">
              <label class="flex cursor-pointer items-start gap-3 rounded-xl border border-slate-200 bg-slate-50 p-4 transition hover:-translate-y-0.5 hover:border-rose-300 hover:bg-rose-50 has-[:checked]:border-rose-500 has-[:checked]:bg-rose-50 has-[:checked]:ring-2 has-[:checked]:ring-rose-100">
                <input type="radio" name="userType" value="guest" required class="sr-only peer">
                <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-white text-lg shadow-sm ring-1 ring-slate-100 peer-checked:bg-rose-500 peer-checked:text-white">&#128737;</span>
                <span><span class="block text-sm font-bold text-slate-800">Guest</span><span class="mt-0.5 block text-xs leading-5 text-slate-500">Find a place to stay</span></span>
              </label>
              <label class="flex cursor-pointer items-start gap-3 rounded-xl border border-slate-200 bg-slate-50 p-4 transition hover:-translate-y-0.5 hover:border-rose-300 hover:bg-rose-50 has-[:checked]:border-rose-500 has-[:checked]:bg-rose-50 has-[:checked]:ring-2 has-[:checked]:ring-rose-100">
                <input type="radio" name="userType" value="host" required class="sr-only peer">
                <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-white text-lg shadow-sm ring-1 ring-slate-100 peer-checked:bg-rose-500 peer-checked:text-white">&#8962;</span>
                <span><span class="block text-sm font-bold text-slate-800">Host</span><span class="mt-0.5 block text-xs leading-5 text-slate-500">Share your space</span></span>
              </label>
            </div>
          </fieldset>

          <div class="grid gap-5 sm:grid-cols-2">
            <div>
              <label for="password" class="mb-2 block text-sm font-semibold text-slate-700">Password</label>
              <input id="password" type="password" placeholder="At least 8 characters" name="password" autocomplete="new-password" required class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm outline-none transition duration-200 placeholder:text-slate-400 hover:border-rose-200 focus:border-rose-500 focus:bg-white focus:ring-4 focus:ring-rose-100">
            </div>
            <div>
              <label for="confirmPassword" class="mb-2 block text-sm font-semibold text-slate-700">Confirm password</label>
              <input id="confirmPassword" type="password" placeholder="Repeat your password" name="Confirmpassword" autocomplete="new-password" required class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm outline-none transition duration-200 placeholder:text-slate-400 hover:border-rose-200 focus:border-rose-500 focus:bg-white focus:ring-4 focus:ring-rose-100">
            </div>
          </div>

          <label class="flex cursor-pointer items-start gap-3 rounded-xl p-1 text-sm text-slate-500">
            <input type="checkbox" name="termsAccepted" required class="mt-0.5 h-4 w-4 shrink-0 rounded border-slate-300 accent-rose-500">
            <span>I agree to the <a href="#" class="font-semibold text-rose-600 hover:text-rose-700 hover:underline">Terms and Conditions</a> and acknowledge the Privacy Policy.</span>
          </label>

          <button type="submit" class="w-full rounded-xl bg-gradient-to-r from-rose-500 to-orange-400 px-4 py-3.5 text-sm font-bold text-white shadow-lg shadow-rose-300/50 transition duration-200 hover:-translate-y-0.5 hover:from-rose-600 hover:to-orange-500 hover:shadow-xl focus:outline-none focus:ring-4 focus:ring-rose-200">Create my account</button>
        </form>

        <p class="mt-7 text-center text-sm text-slate-500">Already have an account? <a href="/auth/login" class="font-bold text-rose-600 hover:text-rose-700 hover:underline">Log in</a></p>
      </section>
    </div>
  </main>
</body>
</html>
