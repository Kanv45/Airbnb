<%- include('../partials/head', { title: 'Login' }) %>
</head>
<body class="min-h-screen bg-rose-50 font-sans text-slate-800">
  <%- include('../partials/header') %>

  <main class="relative flex min-h-[calc(100vh-4.5rem)] items-center overflow-hidden px-4 py-10 sm:px-6 lg:py-16">
    <div class="absolute -left-24 top-10 h-72 w-72 rounded-full bg-rose-200/60 blur-3xl"></div>
    <div class="absolute -right-24 bottom-0 h-80 w-80 rounded-full bg-orange-200/60 blur-3xl"></div>

    <div class="relative mx-auto grid w-full max-w-5xl overflow-hidden rounded-[2rem] bg-white shadow-2xl shadow-rose-950/10 ring-1 ring-rose-100 lg:grid-cols-5">
      <aside class="relative hidden overflow-hidden bg-gradient-to-br from-rose-500 via-rose-500 to-orange-400 p-10 text-white lg:col-span-2 lg:flex lg:flex-col">
        <div class="absolute -right-20 -top-16 h-56 w-56 rounded-full border-[28px] border-white/15"></div>
        <div class="absolute -bottom-24 -left-20 h-64 w-64 rounded-full bg-white/10"></div>
        <a href="/" class="relative text-2xl font-bold tracking-tight">stay<span class="text-rose-100">finder</span></a>
        <div class="relative my-auto">
          <p class="mb-3 text-sm font-semibold uppercase tracking-[0.22em] text-rose-100">Welcome back</p>
          <h1 class="text-4xl font-bold leading-tight">More than a stay. A place to belong.</h1>
          <p class="mt-5 text-base leading-7 text-rose-50">Sign in to manage your bookings, saved homes, and listings all in one place.</p>
        </div>
        <div class="relative flex items-center gap-3 text-sm text-rose-100"><span class="flex h-8 w-8 items-center justify-center rounded-full bg-white/20 font-bold">&#10003;</span>Your favourite places are waiting for you.</div>
      </aside>

      <section class="p-6 sm:p-10 lg:col-span-3">
        <div class="mb-8">
          <span class="inline-flex items-center rounded-full bg-rose-100 px-3 py-1 text-xs font-bold uppercase tracking-wider text-rose-600">Welcome back</span>
          <%if(typeof errorMessages !== 'undefined' && errorMessages &&errorMessages.length>0){%>
            <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative mb-4" role="alert">
              <ul class="list-disc list-inside space-y-1">
                <%errorMessages.forEach(error=>{%>
                <li><%=error%></li>
                <%})%>
              </ul>
            </div>
            <%}%>
          <h2 class="mt-4 text-3xl font-bold tracking-tight text-slate-900">Log in to your account</h2>
          <p class="mt-2 text-sm text-slate-500">Enter your details to continue your journey.</p>
        </div>

        <form action="/auth/login" method="POST" class="space-y-5">
          <div>
            <label for="email" class="mb-2 block text-sm font-semibold text-slate-700">Email address </label>
            <input id="email" type="email" placeholder="you@example.com" name="email" autocomplete="username" required class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm outline-none transition duration-200 placeholder:text-slate-400 hover:border-rose-200 focus:border-rose-500 focus:bg-white focus:ring-4 focus:ring-rose-100">
          </div>

          <div>
            <div class="mb-2 flex items-center justify-between gap-3">
              <label for="password" class="block text-sm font-semibold text-slate-700">Password</label>
              <a href="#" class="text-xs font-bold text-rose-600 hover:text-rose-700 hover:underline">Forgot password?</a>
            </div>
            <input id="password" type="password" placeholder="Enter your password" name="password" autocomplete="current-password" required class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm outline-none transition duration-200 placeholder:text-slate-400 hover:border-rose-200 focus:border-rose-500 focus:bg-white focus:ring-4 focus:ring-rose-100">
          </div>

          <label class="flex cursor-pointer items-center gap-3 pt-1 text-sm text-slate-500">
            <input type="checkbox" name="rememberMe" class="h-4 w-4 rounded border-slate-300 accent-rose-500">
            Remember me on this device
          </label>

          <button type="submit" class="w-full rounded-xl bg-gradient-to-r from-rose-500 to-orange-400 px-4 py-3.5 text-sm font-bold text-white shadow-lg shadow-rose-300/50 transition duration-200 hover:-translate-y-0.5 hover:from-rose-600 hover:to-orange-500 hover:shadow-xl focus:outline-none focus:ring-4 focus:ring-rose-200">Log in</button>
        </form>

        <div class="my-7 flex items-center gap-3 text-xs text-slate-400"><span class="h-px flex-1 bg-slate-200"></span><span>NEW TO STAYFINDER?</span><span class="h-px flex-1 bg-slate-200"></span></div>
        <a href="/auth/signup" class="flex w-full items-center justify-center rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm font-bold text-rose-600 transition hover:border-rose-300 hover:bg-rose-100 focus:outline-none focus:ring-4 focus:ring-rose-100">Create a free account</a>
      </section>
    </div>
  </main>
</body>
</html>
