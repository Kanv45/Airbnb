<%- include('../partials/head', { title: 'Home Added | Stayfinder' }) %>

</head>

<body class="min-h-screen bg-rose-50 font-sans text-slate-800">
  <%- include('../partials/header') %>

  <main class="relative min-h-[calc(100vh-80px)] overflow-hidden">

    <!-- Background decorative blobs -->
    <div class="absolute -left-24 top-20 h-72 w-72 rounded-full bg-rose-200/50 blur-3xl"></div>
    <div class="absolute -right-24 bottom-10 h-80 w-80 rounded-full bg-orange-200/50 blur-3xl"></div>

    <!-- Success Section -->
    <section class="relative flex min-h-[calc(100vh-80px)] items-center justify-center px-4 py-16 sm:px-6 lg:px-8">

      <div class="w-full max-w-xl">

        <!-- Success Card -->
        <div class="rounded-3xl bg-white p-8 text-center shadow-xl shadow-rose-950/10 ring-1 ring-rose-100 sm:p-12">

          <!-- Success Icon -->
          <div class="mx-auto flex h-20 w-20 items-center justify-center rounded-full bg-rose-100 text-4xl text-rose-500 shadow-sm">
            &#10003;
          </div>

          <!-- Heading -->
          <p class="mt-6 text-sm font-bold uppercase tracking-[0.25em] text-rose-500">
            Stayfinder
          </p>

          <h1 class="mt-3 text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl">
            Home Added Successfully
          </h1>

          <!-- Description -->
          <p class="mx-auto mt-4 max-w-md text-base leading-7 text-slate-500">
            Your home has been successfully added to Stayfinder.
            Guests can now discover and explore your beautiful stay.
          </p>

          <!-- Divider -->
          <div class="my-8 border-t border-slate-100"></div>

          <!-- Actions -->
          <div class="flex flex-col justify-center gap-3 sm:flex-row">

            <a
              href="/host/add-home"
              class="inline-flex items-center justify-center rounded-xl bg-gradient-to-r from-rose-500 to-orange-400 px-6 py-3 text-sm font-bold text-white shadow-lg shadow-rose-200/60 transition hover:-translate-y-0.5 hover:from-rose-600 hover:to-orange-500 hover:shadow-xl focus:outline-none focus:ring-4 focus:ring-rose-100"
            >
              Add Another Home
            </a>

            <a
              href="/host-list"
              class="inline-flex items-center justify-center rounded-xl bg-rose-50 px-6 py-3 text-sm font-bold text-rose-600 transition hover:bg-rose-500 hover:text-white focus:outline-none focus:ring-4 focus:ring-rose-100"
            >
              View Your Homes
            </a>

          </div>

        </div>

      </div>

    </section>

  </main>

</body>
</html>