<%- include('../partials/head', { title: 'Stayfinder | Find your next stay' }) %>
</head>
<body class="min-h-screen bg-rose-50 font-sans text-slate-800">
  <%- include('../partials/header') %>

  <% const homeImages = [
    'https://images.unsplash.com/photo-1600607687920-4e2a09cf159d?auto=format&fit=crop&w=1200&q=85',
    'https://images.unsplash.com/photo-1600566753086-00f18fb6b3ea?auto=format&fit=crop&w=1200&q=85',
    'https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=1200&q=85',
    'https://images.unsplash.com/photo-1600047509807-ba8f99d2cdde?auto=format&fit=crop&w=1200&q=85',
    'https://images.unsplash.com/photo-1600210492486-724fe5c67fb0?auto=format&fit=crop&w=1200&q=85',
    'https://images.unsplash.com/photo-1600573472591-ee6b68d14c68?auto=format&fit=crop&w=1200&q=85'
  ]; %>

  <main>
   
    <section class="relative overflow-hidden bg-gradient-to-br from-rose-500 via-rose-500 to-orange-400 px-4 py-16 text-white sm:px-6 lg:py-24">
      <div class="absolute -left-20 top-0 h-64 w-64 rounded-full bg-white/10"></div>
      <div class="absolute -right-16 -bottom-24 h-80 w-80 rounded-full border-[34px] border-white/15"></div>
      <div class="relative mx-auto max-w-7xl text-center">
        <p class="text-sm font-bold uppercase tracking-[0.28em] text-rose-100">Find your perfect escape</p>
        <h1 class="mx-auto mt-4 max-w-3xl text-4xl font-extrabold tracking-tight sm:text-5xl lg:text-6xl">Feel at home, anywhere.</h1>
        <p class="mx-auto mt-5 max-w-2xl text-base leading-7 text-rose-50 sm:text-lg">Discover handpicked spaces that turn every trip into an unforgettable stay.</p>
        <a href="#homes" class="mt-8 inline-flex items-center gap-2 rounded-xl bg-white px-5 py-3 text-sm font-bold text-rose-600 shadow-lg shadow-rose-950/15 transition hover:-translate-y-0.5 hover:bg-rose-50 hover:shadow-xl">Explore stays <span aria-hidden="true">&#8594;</span></a>
      </div>
    </section>

    <section id="homes" class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8 lg:py-16">
      <div class="mb-8 flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
        <div>
          <p class="text-sm font-bold uppercase tracking-[0.2em] text-rose-500">Popular stays</p>
          <h2 class="mt-2 text-3xl font-extrabold tracking-tight text-slate-900">Homes guests love</h2>
          <p class="mt-2 text-sm text-slate-500">Browse places chosen for comfort, character, and great memories.</p>
        </div>
        <span class="inline-flex w-fit rounded-full bg-white px-4 py-2 text-sm font-semibold text-slate-500 shadow-sm ring-1 ring-rose-100"><%= homes.length %> home<%= homes.length === 1 ? '' : 's' %> available</span>
      </div>

      <% if (homes.length > 0) { %>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          <% homes.forEach((home, index) => { %>
            <article class="group overflow-hidden rounded-2xl bg-white shadow-md shadow-rose-950/5 ring-1 ring-slate-200 transition duration-300 hover:-translate-y-1.5 hover:shadow-xl hover:shadow-rose-950/10">
              <div class="relative h-60 overflow-hidden">
                <img src="<%= homeImages[index % homeImages.length] %>" alt="<%= home.username %> in <%= home.location %>" class="h-full w-full object-cover transition duration-500 group-hover:scale-110">
                <div class="absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-slate-900/45 to-transparent"></div>
                <span class="absolute left-4 top-4 rounded-full bg-white/90 px-3 py-1.5 text-xs font-bold text-rose-600 shadow-sm backdrop-blur">Guest favourite</span>
                <span class="absolute bottom-4 right-4 inline-flex items-center gap-1 rounded-full bg-white px-3 py-1.5 text-sm font-bold text-slate-800 shadow-md"><span class="text-amber-400">&#9733;</span><%= home.rating %></span>
              </div>

              <div class="p-5">
                <div class="flex items-start justify-between gap-3">
                  <div class="min-w-0">
                    <h3 class="truncate text-lg font-bold text-slate-900"><%= home.username %></h3>
                    <p class="mt-1 flex items-center gap-1 truncate text-sm text-slate-500"><span class="text-rose-500" aria-hidden="true">&#9679;</span><%= home.location %></p>
                  </div>
                  <p class="whitespace-nowrap text-sm font-bold text-slate-900"><span class="text-base text-rose-600">₹<%= home.price %></span><span class="font-medium text-slate-400"> / night</span></p>
                </div>
                <div class="mt-5 flex items-center justify-between border-t border-slate-100 pt-4">
                  <span class="text-xs font-medium text-slate-400">Entire place</span>
                  <a href="/user/home/<%= home._id %>" class="rounded-lg bg-rose-50 px-3.5 py-2 text-sm font-bold text-rose-600 transition hover:bg-rose-500 hover:text-white focus:outline-none focus:ring-4 focus:ring-rose-100">View stay</a>
                </div>
              </div>
            </article>
          <% }) %>
        </div>
      <% } else { %>
        <div class="rounded-2xl border border-dashed border-rose-200 bg-white px-6 py-16 text-center">
          <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-2xl bg-rose-100 text-2xl text-rose-500">&#8962;</div>
          <h3 class="mt-5 text-xl font-bold text-slate-900">No homes available yet</h3>
          <p class="mt-2 text-sm text-slate-500">Check back soon—new spaces are being added.</p>
        </div>
      <% } %>
    </section>
  </main>
</body>
</html>
