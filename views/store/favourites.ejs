<%- include('../partials/head', { title: 'Favourite homes | Stayfinder' }) %>
</head>
<body class="min-h-screen bg-rose-50 font-sans text-slate-800">
  <%- include('../partials/header') %>

  <% const homeImages = [
    'https://images.unsplash.com/photo-1600607687920-4e2a09cf159d?auto=format&fit=crop&w=1200&q=85',
    'https://images.unsplash.com/photo-1600566753086-00f18fb6b3ea?auto=format&fit=crop&w=1200&q=85',
    'https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=1200&q=85',
    'https://images.unsplash.com/photo-1600047509807-ba8f99d2cdde?auto=format&fit=crop&w=1200&q=85',
    'https://images.unsplash.com/photo-1600210492486-724fe5c67fb0?auto=format&fit=crop&w=1200&q=85',
    'https://images.unsplash.com/photo-1600573472591-ee6b68d14c68?auto=format&fit=crop&w=1200&q=85'
  ]; %>

  <main class="relative overflow-hidden">
    <div class="absolute -left-24 top-8 h-72 w-72 rounded-full bg-rose-200/50 blur-3xl"></div>
    <div class="absolute -right-24 top-64 h-80 w-80 rounded-full bg-orange-200/50 blur-3xl"></div>

    <section class="relative border-b border-rose-100 bg-white/75 px-4 py-12 backdrop-blur sm:px-6 lg:py-16">
      <div class="mx-auto max-w-7xl">
        <div class="flex flex-col justify-between gap-5 sm:flex-row sm:items-end">
          <div>
            <p class="flex items-center gap-2 text-sm font-bold uppercase tracking-[0.25em] text-rose-500"><span class="text-base tracking-normal" aria-hidden="true">&#9829;</span>Your saved stays</p>
            <h1 class="mt-3 text-4xl font-extrabold tracking-tight text-slate-900 sm:text-5xl">Favourite homes</h1>
            <p class="mt-3 max-w-xl text-base leading-7 text-slate-500">All the places that caught your eye, saved for whenever you are ready to travel.</p>
          </div>
          <span class="inline-flex w-fit rounded-full bg-rose-100 px-4 py-2 text-sm font-bold text-rose-600"><%= homes.length %> saved home<%= homes.length === 1 ? '' : 's' %></span>
        </div>
      </div>
    </section>

    <section class="relative mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8 lg:py-16">
      <% if (homes.length > 0) { %>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          <% homes.forEach((home, index) => { %>
            <article class="group overflow-hidden rounded-2xl bg-white shadow-md shadow-rose-950/5 ring-1 ring-slate-200 transition duration-300 hover:-translate-y-1.5 hover:shadow-xl hover:shadow-rose-950/10">
              <div class="relative h-60 overflow-hidden">
                <img src="<%= homeImages[index % homeImages.length] %>" alt="<%= home.username %> in <%= home.location %>" class="h-full w-full object-cover transition duration-500 group-hover:scale-110">
                <div class="absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-slate-900/45 to-transparent"></div>
                <span class="absolute left-4 top-4 flex h-10 w-10 items-center justify-center rounded-full bg-white/95 text-lg text-rose-500 shadow-md" aria-label="Saved to favourites">&#9829;</span>
                <span class="absolute bottom-4 right-4 inline-flex items-center gap-1 rounded-full bg-white px-3 py-1.5 text-sm font-bold text-slate-800 shadow-md"><span class="text-amber-400">&#9733;</span><%= home.rating %></span>
              </div>

              <div class="p-5">
                <div class="flex items-start justify-between gap-3">
                  <div class="min-w-0">
                    <h2 class="truncate text-lg font-bold text-slate-900"><%= home.username %></h2>
                    <p class="mt-1 flex items-center gap-1 truncate text-sm text-slate-500"><span class="text-rose-500" aria-hidden="true">&#9679;</span><%= home.location %></p>
                  </div>
                  <p class="whitespace-nowrap text-sm font-bold text-slate-900"><span class="text-base text-rose-600">₹<%= home.price %></span><span class="font-medium text-slate-400"> / night</span></p>
                </div>
                <div class="mt-5 flex items-center justify-between border-t border-slate-100 pt-4">
                  <span class="text-xs font-medium text-slate-400">Saved for later</span>
                  <a href="/user/home/<%= home._id %>" class="rounded-lg bg-rose-50 px-3.5 py-2 text-sm font-bold text-rose-600 transition hover:bg-rose-500 hover:text-white focus:outline-none focus:ring-4 focus:ring-rose-100">View details</a>
                </div>
              </div>
            </article>
          <% }) %>
        </div>
      <% } else { %>
        <div class="rounded-2xl border border-dashed border-rose-200 bg-white px-6 py-16 text-center shadow-sm">
          <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-2xl bg-rose-100 text-3xl text-rose-500">&#9829;</div>
          <h2 class="mt-5 text-xl font-bold text-slate-900">No favourite homes yet</h2>
          <p class="mx-auto mt-2 max-w-sm text-sm leading-6 text-slate-500">Explore our collection and save the places you would love to visit.</p>
          <a href="/home-list" class="mt-6 inline-flex rounded-xl bg-gradient-to-r from-rose-500 to-orange-400 px-5 py-3 text-sm font-bold text-white shadow-lg shadow-rose-200/60 transition hover:-translate-y-0.5 hover:from-rose-600 hover:to-orange-500 hover:shadow-xl">Explore homes</a>
        </div>
      <% } %>
    </section>
  </main>
</body>
</html>
