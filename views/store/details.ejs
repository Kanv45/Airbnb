<%- include('../partials/head', { title: home.username + ' | Stayfinder' }) %>
</head>
<body class="min-h-screen bg-rose-50 font-sans text-slate-800">
  <%- include('../partials/header') %>

  <main class="relative overflow-hidden px-4 py-8 sm:px-6 lg:py-12">
    <div class="absolute -left-28 top-20 h-80 w-80 rounded-full bg-rose-200/45 blur-3xl"></div>
    <div class="absolute -right-28 bottom-16 h-80 w-80 rounded-full bg-orange-200/45 blur-3xl"></div>

    <div class="relative mx-auto max-w-7xl">
      <a href="/home-list" class="mb-6 inline-flex items-center gap-2 text-sm font-bold text-rose-600 transition hover:text-rose-700"><span aria-hidden="true">&#8592;</span> Back to all homes</a>

      <section class="overflow-hidden rounded-3xl bg-white shadow-xl shadow-rose-950/5 ring-1 ring-rose-100">
        <div class="grid gap-1 bg-white md:grid-cols-2">
          <div class="relative h-72 overflow-hidden md:h-[30rem]">
            <img src="https://images.unsplash.com/photo-1600607687920-4e2a09cf159d?auto=format&fit=crop&w=1400&q=90" alt="<%= home.username %> exterior" class="h-full w-full object-cover">
            <span class="absolute left-5 top-5 rounded-full bg-white/95 px-3 py-1.5 text-xs font-bold text-rose-600 shadow-sm">Guest favourite</span>
          </div>
          <div class="grid h-72 grid-cols-2 gap-1 md:h-[30rem]">
            <img src="https://images.unsplash.com/photo-1600566753086-00f18fb6b3ea?auto=format&fit=crop&w=900&q=85" alt="Bright home interior" class="h-full w-full object-cover">
            <img src="https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=900&q=85" alt="Comfortable living area" class="h-full w-full object-cover">
            <img src="https://images.unsplash.com/photo-1600047509807-ba8f99d2cdde?auto=format&fit=crop&w=900&q=85" alt="Modern home exterior" class="h-full w-full object-cover">
            <div class="relative overflow-hidden">
              <img src="https://images.unsplash.com/photo-1600210492486-724fe5c67fb0?auto=format&fit=crop&w=900&q=85" alt="Home living space" class="h-full w-full object-cover">
            </div>
          </div>
        </div>

        <div class="grid gap-10 p-6 sm:p-10 lg:grid-cols-[minmax(0,1fr)_22rem]">
          <section>
            <div class="flex flex-col justify-between gap-5 border-b border-slate-100 pb-7 sm:flex-row sm:items-start">
              <div>
                <p class="text-sm font-bold uppercase tracking-[0.2em] text-rose-500">Entire home in <%= home.location %></p>
                <h1 class="mt-2 text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl"><%= home.username %></h1>
                <p class="mt-3 inline-flex items-center gap-1.5 text-sm font-semibold text-slate-600"><span class="text-amber-400">&#9733;</span><%= home.rating %> rating <span class="text-slate-300">|</span> <span class="text-rose-500">&#9679;</span><%= home.location %></p>
              </div>
              <div class="rounded-2xl bg-rose-50 px-4 py-3 text-left sm:text-right">
                <p class="text-xs font-bold uppercase tracking-wider text-rose-400">From</p>
                <p class="mt-1 text-xl font-extrabold text-rose-600">₹<%= home.price %><span class="text-sm font-medium text-slate-400"> / night</span></p>
              </div>
            </div>

            <section class="border-b border-slate-100 py-7">
              <h2 class="text-xl font-bold text-slate-900">About this home</h2>
              <p class="mt-3 text-sm font-bold uppercase tracking-[0.16em] text-rose-500">Description (sample)</p>
              <p class="mt-2 max-w-2xl text-base leading-7 text-slate-600">Settle into a bright, welcoming home designed for relaxed mornings and easy evenings. Enjoy a thoughtfully arranged living space, comfortable bedrooms, and a convenient location close to the best of <%= home.location %>. This sample description can be replaced with your own property details when you add a description field to the Home model.</p>
            </section>

            <section class="py-7">
              <h2 class="text-xl font-bold text-slate-900">What this place offers</h2>
              <div class="mt-5 grid gap-4 text-sm text-slate-600 sm:grid-cols-2">
                <p class="flex items-center gap-3"><span class="flex h-9 w-9 items-center justify-center rounded-xl bg-rose-100 text-rose-500">&#8962;</span>Entire home</p>
                <p class="flex items-center gap-3"><span class="flex h-9 w-9 items-center justify-center rounded-xl bg-rose-100 text-rose-500">&#10024;</span>Comfortable living space</p>
                <p class="flex items-center gap-3"><span class="flex h-9 w-9 items-center justify-center rounded-xl bg-rose-100 text-rose-500">&#10003;</span>Highly rated stay</p>
                <p class="flex items-center gap-3"><span class="flex h-9 w-9 items-center justify-center rounded-xl bg-rose-100 text-rose-500">&#9679;</span>Great location</p>
              </div>
            </section>
          </section>

          <aside class="h-fit rounded-2xl border border-rose-100 bg-white p-6 shadow-lg shadow-rose-950/5 lg:sticky lg:top-24">
            <div class="flex items-baseline justify-between gap-3">
              <p class="text-xl font-extrabold text-slate-900">₹<%= home.price %><span class="text-sm font-medium text-slate-400"> / night</span></p>
              <p class="text-sm font-semibold text-slate-500"><span class="text-amber-400">&#9733;</span> <%= home.rating %></p>
            </div>
            <p class="mt-5 rounded-xl bg-rose-50 p-4 text-sm leading-6 text-slate-500">Choose your dates and guest details when the reservation feature is ready.</p>
            <button type="button" class="mt-4 w-full rounded-xl bg-gradient-to-r from-rose-500 to-orange-400 px-4 py-3.5 text-sm font-bold text-white shadow-lg shadow-rose-300/50 transition hover:-translate-y-0.5 hover:from-rose-600 hover:to-orange-500 hover:shadow-xl focus:outline-none focus:ring-4 focus:ring-rose-200">Reserve</button>
            <p class="mt-3 text-center text-xs text-slate-400">You will not be charged yet.</p>
            <div class="mt-5 flex items-center justify-between border-t border-slate-100 pt-4 text-sm"><span class="text-slate-500">Nightly price</span><span class="font-bold text-slate-800">₹<%= home.price %></span></div>
            <div class="mt-2 flex items-center justify-between text-sm"><span class="text-slate-500">Service fee</span><span class="font-bold text-slate-800">Calculated later</span></div>
            <div class="mt-4 flex items-center justify-between border-t border-slate-200 pt-4 text-sm font-extrabold text-slate-900"><span>Total</span><span>At checkout</span></div>
            <div class="mt-5"><%- include('../partials/form', { home: home }) %></div>
          </aside>
        </div>
      </section>
    </div>
  </main>
</body>
</html>
