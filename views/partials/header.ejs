<header class="sticky top-0 z-50 border-b border-rose-100 bg-white/90 shadow-sm shadow-rose-950/5 backdrop-blur">
  <nav class="mx-auto flex min-h-[4.5rem] max-w-7xl flex-wrap items-center gap-x-6 gap-y-3 px-4 py-3 sm:px-6 lg:px-8" aria-label="Main navigation">
    <a href="/" class="group mr-auto inline-flex items-center gap-2 text-xl font-extrabold tracking-tight text-slate-900">
      <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-gradient-to-br from-rose-500 to-orange-400 text-lg text-white shadow-md shadow-rose-200 transition group-hover:scale-105">&#9829;</span>
      stay<span class="text-rose-500">finder</span>
    </a>
   <%console.log(typeof isLoggedIn)%>
    <% if (isLoggedIn) { %>
     
      <div class="order-3 flex w-full items-center gap-1 overflow-x-auto pb-1 text-sm font-semibold text-slate-600 sm:order-none sm:w-auto sm:pb-0">
           <% if (user.userType==="guest") { %>
        <a href="/home-list" class="whitespace-nowrap rounded-lg px-3 py-2 transition hover:bg-rose-50 hover:text-rose-600">Explore homes</a>
        <a href="/user/home/favHomes" class="whitespace-nowrap rounded-lg px-3 py-2 transition hover:bg-rose-50 hover:text-rose-600">Favourites</a>
        <a href="/user/home/bookings" class="whitespace-nowrap rounded-lg px-3 py-2 transition hover:bg-rose-50 hover:text-rose-600">My bookings</a>
        <%}else{%>
        <a href="/user/home" class="whitespace-nowrap rounded-lg px-3 py-2 transition hover:bg-rose-50 hover:text-rose-600">Add a home</a>
        <a href="/host-list" class="whitespace-nowrap rounded-lg px-3 py-2 transition hover:bg-rose-50 hover:text-rose-600">Hosts</a>
        <%}%>
      </div>
      <form action="/logout" method="POST" class="ml-auto sm:ml-0">
        <button type="submit" class="rounded-lg border border-rose-200 bg-rose-50 px-4 py-2 text-sm font-bold text-rose-600 transition hover:border-rose-300 hover:bg-rose-100 focus:outline-none focus:ring-4 focus:ring-rose-100">Log out</button>
      </form>
    <% } else { %>
      <div class="flex items-center gap-2">
        <a href="/auth/login" class="rounded-lg px-4 py-2 text-sm font-bold text-slate-600 transition hover:bg-rose-50 hover:text-rose-600">Log in</a>
        <a href="/auth/signup" class="rounded-lg bg-gradient-to-r from-rose-500 to-orange-400 px-4 py-2 text-sm font-bold text-white shadow-md shadow-rose-200 transition hover:-translate-y-0.5 hover:from-rose-600 hover:to-orange-500 hover:shadow-lg focus:outline-none focus:ring-4 focus:ring-rose-200">Sign up</a>
      </div>
    <% } %>
  </nav>
</header>
